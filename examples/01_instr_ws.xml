<?xml version="1.0" encoding="UTF-8"?>
<Procedure>
    <Sequence name="Root sequence">
        <Wait name="Short wait" timeout="0.1" />
        <Output name="Print variable" fromVar="var1"
                description="Printing a workspace variable" />
        <Output name="Print variable field" fromVar="var1.enabled"
                description="Printing a workspace variable field" />
    </Sequence>
    <Workspace>
        <Local name="var1"
               type='{"type":"var1_t","attributes":[
                            {"enabled":{"type":"bool"}},
                            {"setpoint":{"type":"float64"}}]}'
                value='{"enabled":true,"setpoint":2.7}' />
    </Workspace>
</Procedure>
