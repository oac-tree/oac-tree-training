<?xml version="1.0" encoding="UTF-8"?>
<Procedure>
    <Plugin>liboac-tree-mathexpr.so</Plugin>
    <Repeat maxCount="20">
        <Sequence>
            <MathExpression expression="y:=x^2"/>
            <Output fromVar="y"/>
            <Increment varName="x"/>
        </Sequence>
    </Repeat>
    <Workspace>
      <Local name="x" type='{"type":"uint64"}' value='1' />
      <Local name="y" type='{"type":"uint64"}'/>
    </Workspace>
</Procedure>
