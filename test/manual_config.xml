<?xml version="1.0" encoding="UTF-8"?>
<Procedure xmlns="http://codac.iter.org/sup/sequencer" version="1.0"
           name="Procedure for manually configuring the systems in the Sequencer training"
           xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
           xs:schemaLocation="http://codac.iter.org/sup/sequencer sequencer.xsd">
    <Plugin>libsequencer-sup-config.so</Plugin>
    <UserChoice>
        <Sequence name="Output signal generator configuration">
            <ReadConfiguration name="Read signal generator configuration"
                service="test:SignalGeneratorConfigServer"
                outputVar="config"/>
            <Output description="Signal generator configuration" fromVar="config"/>
        </Sequence>
        <Sequence name="Configure signal generator output 1">
            <ReadConfiguration name="Read signal generator configuration for output 1"
                service="test:SignalGeneratorConfigServer"
                configName="out1"
                outputVar="config"/>
            <Output description="Previous configuration" fromVar="config"/>
            <Input description="Set configuration values" outputVar="config"/>
            <WriteConfiguration name="Write signal generator configuration for output 1"
                service="test:SignalGeneratorConfigServer"
                configName="out1"
                inputVar="config"/>
            <Output description="New configuration" fromVar="config"/>
        </Sequence>
        <Sequence name="Configure signal generator output 2">
            <ReadConfiguration name="Read signal generator configuration for output 2"
                service="test:SignalGeneratorConfigServer"
                configName="out2"
                outputVar="config"/>
            <Output description="Previous configuration" fromVar="config"/>
            <Input description="Set configuration values" outputVar="config"/>
            <WriteConfiguration name="Write signal generator configuration for output 2"
                service="test:SignalGeneratorConfigServer"
                configName="out2"
                inputVar="config"/>
            <Output description="New configuration" fromVar="config"/>
        </Sequence>
        <Sequence name="Activate signal generator">
            <ReadConfiguration name="Read signal generator configuration"
                service="test:SignalGeneratorConfigServer"
                outputVar="config"/>
            <Output description="Previous configuration" fromVar="config"/>
            <Copy inputVar="true" outputVar="config.active" />
            <WriteConfiguration name="Write signal generator configuration"
                service="test:SignalGeneratorConfigServer"
                inputVar="config"/>
            <Output description="New configuration" fromVar="config"/>
        </Sequence>
        <Sequence name="Deactivate signal generator">
            <ReadConfiguration name="Read signal generator configuration"
                service="test:SignalGeneratorConfigServer"
                outputVar="config"/>
            <Output description="Previous configuration" fromVar="config"/>
            <Copy inputVar="false" outputVar="config.active" />
            <WriteConfiguration name="Write signal generator configuration"
                service="test:SignalGeneratorConfigServer"
                inputVar="config"/>
            <Output description="New configuration" fromVar="config"/>
        </Sequence>
    </UserChoice>
    <Workspace>
        <Local name="true" type='{"type":"bool"}' value="true"/>
        <Local name="false" type='{"type":"bool"}' value="false"/>
        <Local name="config" dynamicType="true" />
    </Workspace>
</Procedure>