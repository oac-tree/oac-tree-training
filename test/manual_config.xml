<?xml version="1.0" encoding="UTF-8"?>
<Procedure xmlns="http://codac.iter.org/sup/sequencer" version="1.0"
           name="Procedure for manually configuring the systems in the Sequencer training"
           xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
           xs:schemaLocation="http://codac.iter.org/sup/sequencer sequencer.xsd">
    <Plugin>libsequencer-sup-config.so</Plugin>
    <Sequence name="Configure signal generator output 1">
        <ReadConfiguration name="Read signal generator configuration for output 1"
            service="test:SignalGeneratorConfigServer"
            configName="out1"
            outputVar="config"/>
        <Output description="Previous configuration" fromVar="config"/>
        <Input description="Set configuration values" outputVar="config"/>
        <WriteConfiguration name="Write signal generator configuration for output 1"
            service="test:SignalGeneratorConfigServer"
            configName="out1"
            inputVar="config"/>
    </Sequence>
    <Workspace>
        <Local name="config" dynamicType="true" />
    </Workspace>
</Procedure>