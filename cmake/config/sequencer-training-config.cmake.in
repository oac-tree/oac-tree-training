#  SEQUENCER_TRAINING_INCLUDE_DIRS - include directories
#  SEQUENCER_TRAINING_LIBRARIES    - libraries to link against

get_filename_component(SEQUENCER_TRAINING_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

if(TARGET sequencer-training::signal-generator-config)
else()
  message(STATUS "sequencer-training-config.cmake including ${SEQUENCER_TRAINING_CMAKE_DIR}/sequencer-training-targets.cmake")
  include("${SEQUENCER_TRAINING_CMAKE_DIR}/sequencer-training-targets.cmake")
endif()

set(SEQUENCER_TRAINING_LIBRARIES sequencer-training::signal-generator-config)

message(STATUS "sequencer-training-config.cmake in ${CMAKE_CURRENT_LIST_FILE}")
message(STATUS "SEQUENCER_TRAINING_LIBRARIES ${SEQUENCER_TRAINING_LIBRARIES}")
